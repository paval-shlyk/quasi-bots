  "query": "\n        SELECT\n            id AS \"id!\",\n            event_id AS \"event_id!\",\n            watch_id AS \"watch_id!\",\n            channel AS \"channel!\",\n            payload AS \"payload!\",\n            created_at AS \"created_at!\",\n            delivered_telegram_at,\n            acked_mcp_at\n        FROM alert_outbox\n        WHERE delivered_telegram_at IS NULL\n          AND channel IN ('telegram', 'both')\n        ORDER BY id ASC\n        LIMIT ?\n        ",
