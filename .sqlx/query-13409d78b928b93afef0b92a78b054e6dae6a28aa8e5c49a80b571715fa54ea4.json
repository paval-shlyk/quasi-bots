  "query": "\n        SELECT q.id, q.text, a.name as author, q.when_used as \"when_used: chrono::DateTime<chrono::Utc>\"\n        FROM quote q\n        JOIN author a ON q.author_id = a.id\n        WHERE q.when_used IS NULL OR q.when_used < datetime('now', '-6 months')\n        LIMIT 1\n        ",
