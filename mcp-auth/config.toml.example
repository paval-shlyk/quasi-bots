public_url = "http://127.0.0.1:8080"
# External AS issuer (Keycloak realm URL or Zitadel instance issuer)
authorization_server = "https://auth.example.com/realms/mcp"
scope = "mcp"
# Optional JWT sub allowlist (empty = any subject with a valid token)
allowed_subs = []
allowed_origins = []
stateful_mode = false
json_response = true
