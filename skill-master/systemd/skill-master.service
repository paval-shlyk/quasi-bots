[Unit]
Description=Skill Master Service
After=network.target

[Service]
Type=simple
ExecStart=/usr/bin/skill-master --config /etc/skill-master/config.toml
Restart=always
RestartSec=1s
User=skill-master
WorkingDirectory=/var/lib/skill-master
Environment=RUST_LOG=info

[Install]
WantedBy=multi-user.target
